UNOUR_RELEASE=local
# CI updates these independently; empty values fall back to UNOUR_RELEASE.
UNOUR_API_RELEASE=
UNOUR_WEB_RELEASE=
UNOUR_ORIGINS=https://csac.chat
UNOUR_PORT=18080
UNO_SECURE_COOKIES=true
UNO_MAX_ROOMS=1000
# Disabled by default. Generate this private file inside the persistent volume first.
# UNO_ADMIN_CONFIG=/data/admin.json
# Frontend Git checkout, relative to this compose.yaml.
UNOUR_WEB_CONTEXT=../unour-web

# Optional compose.rules.yaml: complete, readable host-side JSON rule directory.
# UNOUR_RULES_DIR=/opt/unour/rules
# Preserve the optional mount during CI deployments (after copying the override).
# COMPOSE_FILE=compose.yaml:compose.rules.yaml
