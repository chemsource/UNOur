# Include this file at the END of sshd_config, after global settings.
Match User unour-deploy
    PubkeyAuthentication yes
    PasswordAuthentication no
    AuthenticationMethods publickey
    AuthorizedKeysFile /etc/ssh/authorized_keys/unour-deploy
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitUserRC no
